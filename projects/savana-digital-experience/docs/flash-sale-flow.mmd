flowchart TD
    a["首页核心 Flash Sale 入口"]
    s{"活动与商品当前有效？"}
    no["未生效 / 已结束 / 无商品"]
    p["Flash Sale Feed → 商品详情"]
    k{"选规格、数量并校验"}
    sold["售罄 / 不可选：换选"]
    c["购物车确认活动信息"]
    ch{"结算与提交前复核"}
    change["规则 / 价格变化：重新确认"]
    order["创建订单并进入支付"]
    res["查询最终订单 / 支付结果"]
    a --> s
    s --> |"不可用"| no
    s --> |"有效"| p
    p --> k
    k --> |"不可售"| sold
    k --> |"可售"| c
    c --> ch
    ch --> |"变化 / 失效"| change
    ch --> |"有效且已确认"| order
    order --> res
