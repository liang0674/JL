flowchart TD
    a["识别 Urbanic 账户并说明授权"]
    b{"用户是否确认？"}
    c["取消：再次授权或退出"]
    d{"校验身份与账户关系"}
    l["关联 / 创建 Savana 账户并登录"]
    q{"Welcome Coupon 权益校验"}
    no["无资格 / 已领：说明结果"]
    rq{"发券请求与最终结果"}
    ok["成功：展示券与条件"]
    unk["未知：先查发券记录"]
    fail["失败：保留登录并处理"]
    end["Shop Now → 浏览 → 加购 → 结算"]
    a --> b
    b --> |"取消"| c
    b --> |"确认"| d
    d --> |"成功"| l
    l --> q
    q --> |"否 / 已领"| no
    q --> |"是"| rq
    rq --> |"成功"| ok
    rq --> |"未知"| unk
    rq --> |"明确失败"| fail
    ok --> end
    no -.-> |"可继续购物"| end
    unk -.-> |"查询成功"| ok
    unk -.-> |"查询明确失败"| fail
